# Dev tasks for lsdocs-transform-toc (run with `nur`; `nur --list` shows them).
# The tasks shared by every lsdocs repository come first; this
# repository's own follow.

use scripts/org.nu

# The organization's repositories and their crates (for `check-git-deps`
# and `link`).
def org-map []: nothing -> record { open scripts/org.nuon }

# Runs cargo with `org-env` (local clones when LSDOCS_ORG_DIR is set).
# PYO3_BUILD_EXTENSION_MODULE builds pyo3 crates as extension modules (no
# libpython link), as maturin does, so plain cargo builds of them work.
def --wrapped cargo-org [...args] {
    with-env ((org org-env) | insert PYO3_BUILD_EXTENSION_MODULE "1") { ^cargo ...$args }
}

# Format the Rust code (`--check` only checks).
def "nur fmt" [--check] {
    if $check { cargo fmt --all -- --check } else { cargo fmt --all }
}

# Clippy, warnings as errors.
def "nur lint" [] {
    cargo-org clippy --workspace --all-targets -- -D warnings
}

# The Rust tests.
def "nur test" [] {
    cargo-org test --workspace
}

# Fails if a crate of the organization is built twice (two sources, or a
# `[patch]` applied on one side only).
def "nur check-dupes" [] {
    let found = org tree-dupes (cargo-org tree --workspace --duplicates -e normal,build,dev | complete)
    if ($found | is-not-empty) {
        error make --unspanned {msg: $"built twice: ($found | str join ', ')"}
    }
    print "check-dupes: OK"
}

# Fails unless every lsdocs dependency is a path inside this repository or
# a git dependency on the organization repository holding it.
def "nur check-git-deps" [] {
    let manifests = glob "{Cargo.toml,crates/*/Cargo.toml,bindings/*/Cargo.toml,tools/*/Cargo.toml}"
    let errors = $manifests | each {|m|
        let dir = $m | path dirname | path relative-to $env.PWD | str replace --all '\' '/' | if $in == "" { "." } else { $in }
        org check-git-deps (open $m) (org-map) --dir $dir | each {|e| $"($m): ($e)" }
    } | flatten
    if ($errors | is-not-empty) {
        for e in $errors { print -e $"error: ($e)" }
        error make --unspanned {msg: "check-git-deps failed"}
    }
    print $"check-git-deps: ($manifests | length) manifest\(s\) OK"
}

# Builds against a local checkout of an organization repository (live
# edits, committed or not): writes `[patch]` entries into the untracked
# .cargo/config.toml. `nur unlink` undoes it.
def "nur link" [path: string] {
    let name = $path | path expand | path basename
    let crates = org-map | get -o $name
    if $crates == null { error make --unspanned {msg: $"`($name)` is not a repository of the organization"} }
    mkdir .cargo
    let file = ".cargo/config.toml"
    let config = if ($file | path exists) { open $file } else { {} }
    let patch = $config | get -o patch | default {} | upsert $"($org.ORG_URL)/($name)" (org patch-entries $path $crates)
    $config | upsert patch $patch | to toml | save -f $file
    print $"linked ($name) -> ($path | path expand)"
}

# Removes `nur link`'s entries (all, or one repository's).
def "nur unlink" [name?: string] {
    let file = ".cargo/config.toml"
    if not ($file | path exists) { return }
    let config = open $file
    let patch = if $name == null { {} } else { $config | get -o patch | default {} | reject -o $"($org.ORG_URL)/($name)" }
    $config | upsert patch $patch | to toml | save -f $file
}

# Checks each crate on its own `rust-version` (installing the toolchains),
# without default features, then the workspace on the highest one.
def "nur msrv" [] {
    let groups = (
        cargo-org metadata --no-deps --format-version 1 | from json | get packages
        | select name rust_version | group-by rust_version
        | transpose version crates
        | sort-by {|g| $g.version | split row "." | each { into int } | $in.0 * 1000 + $in.1 }
    )
    for group in $groups {
        rustup toolchain install $group.version --profile minimal --no-self-update
        let names = $group.crates | get name
        print $"Rust ($group.version): ($names | str join ', ')"
        cargo-org $"+($group.version)" check --no-default-features ...($names | each {|n| [-p $n] } | flatten)
    }
    let highest = $groups | last | get version
    print $"Rust ($highest): the workspace, default features"
    cargo-org $"+($highest)" check --workspace
}

# Licenses, advisories and sources of the dependencies (.config/deny.toml).
# mise installs cargo-deny on first use (.config/mise.deny.toml).
def "nur deny" [] {
    with-env ((org org-env) | insert MISE_ENV deny) { ^mise exec -- cargo deny check }
}

# Updates the lockfile's revision of organization crates (all, or one).
def "nur bump" [crate?: string] {
    if $crate == null { cargo-org update } else { cargo-org update -p $crate }
}

# What CI runs.
def "nur ci" [] {
    nur fmt --check
    nur lint
    nur test
    nur check-dupes
    nur check-git-deps
}
